[Unit]
# Template unit: one lightddns instance per config file in /etc/lightddns.d/.
# %i is the instance name. Enable an instance with, e.g.:
#     cp myhost.yaml /etc/lightddns.d/myhost.yaml
#     systemctl enable --now lightddns@myhost.service
# which runs lightddns against /etc/lightddns.d/myhost.yaml.
Description=lightddns DDNS updater (instance %i)
Documentation=https://lightddns.duaky.com man:lightddns(1)
After=nss-lookup.target network-online.target
Wants=network-online.target

[Service]
Type=exec
User=lightddns
Group=lightddns

# Per-instance state dir /var/lib/lightddns/%i (created by systemd), config read
# as an ABSOLUTE path. -D/--workdir is a ROOT-command flag, before the sub-command.
StateDirectory=lightddns/%i
WorkingDirectory=/var/lib/lightddns/%i

# Shared defaults, plus an optional per-instance file for instance-specific
# secrets and $ARG (e.g. ARG="--once").
EnvironmentFile=-/etc/default/lightddns
EnvironmentFile=-/etc/default/lightddns.%i

ExecStartPre=/usr/bin/lightddns -D /var/lib/lightddns/%i check -c /etc/lightddns.d/%i.yaml
ExecStart=/usr/bin/lightddns -D /var/lib/lightddns/%i run -c /etc/lightddns.d/%i.yaml $ARG

Restart=on-failure
RestartSec=5s
ExecReload=/bin/kill -TERM $MAINPID

# Slot reserved for sd_notify(3) - see lightddns.service for details.
#Type=notify
#NotifyAccess=main
#WatchdogSec=30s

# --- Sandboxing / hardening (kept in sync with lightddns.service) -----------
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
AmbientCapabilities=
#CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
#AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW

[Install]
WantedBy=multi-user.target